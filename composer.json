{
    "name": "coolms/taxonomy-doctrine",
    "description": "Doctrine mapping for the taxonomy entities, kept out of the domain.",
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/coolms/taxonomy-doctrine/issues",
        "source": "https://github.com/coolms/taxonomy-doctrine"
    },
    "require": {
        "coolms/core": "^2.0",
        "coolms/core-doctrine": "^2.0",
        "coolms/entity": "^2.0.0-alpha3",
        "coolms/rql": "^1.0",
        "coolms/rql-doctrine": "^1.0.1",
        "coolms/taxonomy": "^2.0",
        "doctrine/orm": "^3.3",
        "doctrine/persistence": "^4.0",
        "php": "^8.5",
        "symfony/dependency-injection": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "CoolMS\\Taxonomy\\Doctrine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoolMS\\Taxonomy\\Doctrine\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-develop": "2.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
